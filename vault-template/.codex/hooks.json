{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/agent_guard.py",
            "commandWindows": "python tools/agent_guard.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/agent_guard.py",
            "commandWindows": "python tools/agent_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
